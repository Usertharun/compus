NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://compus:replace-me@localhost:5432/compus
DATABASE_URL_UNPOOLED=postgresql://compus:replace-me@localhost:5432/compus
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional URL (redis:// or rediss://) overrides the host/port settings.
REDIS_URL=
REDIS_PASSWORD=
# Gmail SMTP for the beta: use a dedicated sender account with 2-Step Verification.
# Production email uses Brevo's HTTPS API because many hosting plans block SMTP.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Compus

# Optional SMTP fallback for local development or hosts that permit SMTP.
# SMTP_USER is the Gmail address; SMTP_PASS is a Google app password, not its sign-in password.
# SMTP_FROM must use the same address, optionally with display name Compus.
# Signup and recovery stay unavailable until both are configured.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SENTRY_DSN=
LOG_LEVEL=info

# Optional single administrator email; all other accounts require @srmist.edu.in.
# Administrator signup still requires a code delivered to this mailbox.
OWNER_EMAIL=
