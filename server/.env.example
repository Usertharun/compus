# =====================================================
# COMPUS BACKEND ENVIRONMENT CONFIGURATION
# =====================================================

# Server Core Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL / Neon Database URL
DATABASE_URL=postgresql://user:password@localhost:5432/compus_db?schema=public&sslmode=prefer

# Redis Cache & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Minimum 32 characters for production)
JWT_SECRET=super-secret-compus-access-jwt-key-2026!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-compus-refresh-jwt-key-2026!
JWT_REFRESH_EXPIRES_IN=7d

# Sentry Monitoring DSN
SENTRY_DSN=

# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=debug
